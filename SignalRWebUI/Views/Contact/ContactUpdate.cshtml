@model UpdateContactDto

@{
    ViewData["Title"] = "ContactUpdate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Alt İletişim</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Yeni Alt İletişim Güncelleme</div>
						</div>
						<input type="hidden" asp-for="ContactID" />
						<div class="card-body">
							<div class="form-group">
								<label for="ContactLocation">Lokasyon</label>
								<input asp-for="ContactLocation" type="text" class="form-control" id="ContactLocation" placeholder="Lokasyon Giriniz...">
							</div>
							<div class="form-group">
								<label for="ContactPhoneNumber">Telefon</label>
								<input asp-for="ContactPhoneNumber" type="text" class="form-control" id="ContactPhoneNumber" placeholder="Telefon Giriniz...">
							</div>
							<div class="form-group">
								<label for="ContactMail">Mail</label>
								<input asp-for="ContactMail" type="email" class="form-control" id="ContactMail" placeholder="Mail Giriniz...">
							</div>
							<div class="form-group">
								<label for="ContactFooterDescription">Açıklama</label>
								<input asp-for="ContactFooterDescription" type="text" class="form-control" id="ContactFooterDescription" placeholder="Açıklama Giriniz...">
							</div>
							<div class="form-group">
								<label for="ContactTitle">Başlık</label>
								<input asp-for="ContactTitle" type="text" class="form-control" id="ContactTitle" placeholder="Başlık Giriniz...">
							</div>
							<div class="form-group">
								<label for="ContactOpenDescription">Saatler</label>
								<input asp-for="ContactOpenDescription" type="text" class="form-control" id="ContactOpenDescription" placeholder="Saatler İçin Açıklama Giriniz...">
							</div>
							<div class="form-group">
								<label for="ContactOpenDays">Günler</label>
								<input asp-for="ContactOpenDays" type="text" class="form-control" id="ContactOpenDays" placeholder="Günleri Giriniz...">
							</div>
							<div class="form-group">
								<label for="ContactOpenHours">Saatler</label>
								<input asp-for="ContactOpenHours" type="text" class="form-control" id="ContactOpenHours" placeholder="Saatleri Giriniz...">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success">Alt İletişim Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
