@model List<ResultContactDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Alt İletişim</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="card-title mb-0">Alt İletişim Listesi</div>
                        <a href="/Contact/ContactCreate/" class="btn btn-success btn-round">
                            <i class="la la-plus"></i> Yeni Alt İletişim Ekle
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Ana Sayfada Bulunan Alt İletişim ile ilgili işlemleri buradan gerçekleştirebilirsiniz.
                            Sadece 1 tane alan girişi yapınız.
                        </div>
                        <table class="table mt-3" id="contactTable">
                            <thead>
                                <tr>
                                    <th scope="col">Konum</th>
                                    <th scope="col">Telefon</th>
                                    <th scope="col">Mail</th>
                                    <th scope="col">Açıklama</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model == null || !Model.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-4">
                                            Henüz alt iletişim eklenmemiş.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <th>@item.ContactLocation</th>
                                            <td>@item.ContactPhoneNumber</td>
                                            <td>@item.ContactMail</td>
                                            <td>@item.ContactFooterDescription</td>
                                            <td><a href="/Contact/ContactDelete/@item.ContactID" class="btn btn-outline-danger">Sil</a></td>
                                            <td><a href="/Contact/ContactUpdate/@item.ContactID" class="btn btn-outline-primary">Güncelle</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>