@model RegisterDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Katib Restorant Kayıt</title>
    <!-- Mobile Specific Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <!-- Font-->
    <link rel="stylesheet" type="text/css" href="~/colorlib-regform-32/css/nunito-font.css">
    <!-- Main Style Css -->
    <link rel="stylesheet" href="~/colorlib-regform-32/css/style.css" />
</head>
<body class="form-v6">
    <div class="page-content">
        <div class="form-v6-content">
            <div class="form-left">
                <img src="~/colorlib-regform-32/images/login-bg.png" alt="form">
            </div>
            <form class="form-detail" method="post">
                <h2>Katib Restorant Kayıt Formu</h2>
                <div class="form-row">
                    <input type="text" class="input-text" placeholder="Adınız" asp-for="Name">
                    <span asp-validation-for="Name" class="field-error"></span>
                </div>
                <div class="form-row">
                    <input type="text" class="input-text" placeholder="Soyadınız" asp-for="Surname">
                    <span asp-validation-for="Surname" class="field-error"></span>
                </div>
                <div class="form-row">
                    <input type="text" class="input-text" placeholder="Kullanıcı Adınız" asp-for="UserName">
                    <span asp-validation-for="UserName" class="field-error"></span>
                </div>
                <div class="form-row">
                    <input type="email" class="input-text" placeholder="Email Adresiniz" asp-for="Mail">
                    <span asp-validation-for="Mail" class="field-error"></span>
                </div>
                <div class="form-row">
                    <input type="password" class="input-text" placeholder="Şifreniz" asp-for="Password">
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div asp-validation-summary="ModelOnly" class="login-error"></div>
                <div class="form-row-last">
                    <input type="submit" name="register" class="register" value="Kaydol">
                </div>

                <p class="login-link">
                    Zaten bir hesabın var mı?
                    <a asp-controller="Login" asp-action="Index">Giriş Yap</a>
                </p>
            </form>
        </div>
    </div>
</body>
</html>
