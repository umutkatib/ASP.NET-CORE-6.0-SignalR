@model CreateSocialMediaDto

@{
    ViewData["Title"] = "Yeni Sosyal Medya";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="page-title mb-0">Sosyal Medya</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-0">
                    <li class="breadcrumb-item"><a href="/SocialMedia/Index/">Sosyal Medya</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Yeni Sosyal Medya</li>
                </ol>
            </nav>
        </div>

        <div class="row">
            <div class="col-md-12">
                <form method="post" asp-action="SocialMediaCreate" asp-controller="SocialMedia" id="socialMediaForm" novalidate>
                    <div class="card product-card">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="la la-share-alt text-success mr-1"></i> Yeni Sosyal Medya Ekleme
                            </div>
                        </div>

                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="form-group">
                                <label asp-for="SocialMediaTitle" class="font-weight-bold">Başlık</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-tag"></i></span>
                                    </div>
                                    <input asp-for="SocialMediaTitle" class="form-control" maxlength="150"
                                           placeholder="Başlık Giriniz..." autofocus />
                                </div>
                                <span asp-validation-for="SocialMediaTitle" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="SocialMediaIcon" class="font-weight-bold">İkon</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-star"></i></span>
                                    </div>
                                    <input asp-for="SocialMediaIcon" class="form-control"
                                           placeholder="İkon Giriniz... (örn: la la-facebook)" />
                                </div>
                                <span asp-validation-for="SocialMediaIcon" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="SocialMediaUrl" class="font-weight-bold">Link</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-link"></i></span>
                                    </div>
                                    <input asp-for="SocialMediaUrl" class="form-control"
                                           placeholder="https://..." />
                                </div>
                                <span asp-validation-for="SocialMediaUrl" class="text-danger small"></span>
                            </div>

                            @*
                            DTO'nda SocialMediaStatus (bool) varsa bu bloğu aç:

                            <div class="form-group">
                                <label class="font-weight-bold d-block">Durum</label>
                                <div class="custom-control custom-switch">
                                    <input asp-for="SocialMediaStatus" type="checkbox" class="custom-control-input" />
                                    <label class="custom-control-label" asp-for="SocialMediaStatus">Aktif</label>
                                </div>
                            </div>
                            *@
                        </div>

                        <div class="card-action d-flex justify-content-between">
                            <a href="/SocialMedia/Index/" class="btn btn-outline-secondary btn-round">
                                <i class="la la-arrow-left"></i> Vazgeç
                            </a>
                            <button type="submit" class="btn btn-success btn-round" id="btnSubmit">
                                <i class="la la-check"></i> Sosyal Medyayı Ekle
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .product-card {
            border: 0;
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
        }

            .product-card .form-control:focus {
                border-color: #31ce36;
                box-shadow: 0 0 0 .15rem rgba(49,206,54,.2);
            }

            .product-card .input-group-text {
                background: #f8f9fa;
            }
    </style>
    <script>
        // Çift tıklamayla aynı kaydın iki kez eklenmesini engeller
        $('#socialMediaForm').on('submit', function () {
            if ($(this).valid()) {
                $('#btnSubmit').prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm"></span> Kaydediliyor...');
            }
        });
    </script>
}