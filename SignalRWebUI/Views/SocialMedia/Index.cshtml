@model List<ResultSocialMediaDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Sosyal Medya</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="card-title mb-0">Sosyal Medya Listesi</div>
                        <a href="/SocialMedia/SocialMediaCreate/" class="btn btn-success btn-round">
                            <i class="la la-plus"></i> Yeni Sosyal Medya Ekle
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Sosyal Medya ile ilgili işlemleri buradan gerçekleştirebilirsiniz.
                        </div>
                        <table class="table mt-3" id="socialMediaTable">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Başlık</th>
                                    <th scope="col">Link</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model == null || !Model.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            Henüz sosyal medya eklenmemiş.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <th>@item.SocialMediaTitle</th>
                                            <td>@item.SocialMediaUrl</td>
                                            <td><a href="/SocialMedia/SocialMediaDelete/@item.SocialMediaID" class="btn btn-outline-danger">Sil</a></td>
                                            <td><a href="/SocialMedia/SocialMediaUpdate/@item.SocialMediaID" class="btn btn-outline-primary">Güncelle</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap4.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#socialMediaTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25],
                columnDefs: [
                    { orderable: false, targets: [3] }
                ],
                language: {
                    info: "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    infoEmpty: "Kayıt bulunamadı",
                    infoFiltered: "(toplam _MAX_ kayıt içinden filtrelendi)",
                    lengthMenu: "Sayfada _MENU_ kayıt göster",
                    search: "Ara:",
                    zeroRecords: "Eşleşen kayıt bulunamadı",
                    paginate: {
                        first: "İlk",
                        last: "Son",
                        next: "Sonraki",
                        previous: "Önceki"
                    }
                }
            });
        });
    </script>
}