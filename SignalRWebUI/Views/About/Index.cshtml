@model List<ResultAboutDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Hakkımızda</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="card-title mb-0">Hakkımızda Listesi</div>
                        <a href="/About/AboutCreate/" class="btn btn-success btn-round">
                            <i class="la la-plus"></i> Yeni Hakkımızda Ekle
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Ana Sayfada Bulunan Hakkımızda ile ilgili işlemleri buradan gerçekleştirebilirsiniz.
                            Sadece 1 tane alan girişi yapınız.
                        </div>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">Başlık</th>
                                    <th scope="col">Açıklama</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model == null || !Model.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">
                                            Henüz hakkımızda bilgisi eklenmemiş.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <th>@item.AboutTitle</th>
                                            <td>@item.AboutDescription</td>
                                            <td><a href="/About/AboutDelete/@item.AboutID" class="btn btn-outline-danger">Sil</a></td>
                                            <td><a href="/About/AboutUpdate/@item.AboutID" class="btn btn-outline-primary">Güncelle</a></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Başarılı!',
            text: '@TempData["SuccessMessage"]',
            timer: 2500,
            showConfirmButton: false
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Hata!',
            text: '@TempData["ErrorMessage"]'
        });
    </script>
}