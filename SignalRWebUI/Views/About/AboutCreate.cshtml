@model CreateAboutDto

@{
    ViewData["Title"] = "AboutCreate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}


<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Hakkımızda</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Yeni Hakkımızda Ekleme</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="AboutTitle">Başlık</label>
								<input asp-for="AboutTitle" type="text" class="form-control" id="AboutTitle" placeholder="Başlık Giriniz...">
							</div>
							<div class="form-group">
								<label for="AboutDescription">Açıklama</label>
								<textarea rows="5" class="form-control" type="text" asp-for="AboutDescription" id="AboutDescription"  placeholder="Açıklama Giriniz...">

								</textarea>
							</div>
							<div class="form-group">
								<label for="AboutImageUrl">Kategori Adı</label>
								<input asp-for="AboutImageUrl" type="text" class="form-control" id="AboutImageUrl" placeholder="Ürün Görseli Giriniz...">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success">Hakkımızda Ekle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

