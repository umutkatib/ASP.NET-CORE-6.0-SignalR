@model List<ResultBookingDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<!-- DataTables CSS (Bootstrap 4 teması) -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap4.min.css" />

<script src="~/js/site.js" asp-append-version="true"></script>

<div class="content">
    <div class="container-fluid">

        <script type="text/javascript">
            $(document).ready(() => {

                const escapeHtml = (s) => $('<div>').text(s ?? '').html().replace(/"/g, '&quot;');

                const table = $("#bookingTable").DataTable({
                    pageLength: 10,
                    autoWidth: false,
                    language: {
                        url: "https://cdn.datatables.net/plug-ins/1.13.8/i18n/tr.json"
                    },
                    columnDefs: [
                        {
                            targets: 5,
                            render: function (data, type) {
                                if (type !== 'display') return data;
                                const safe = escapeHtml(data);
                                return `<span class="d-inline-block text-truncate align-middle" style="max-width:250px" title="${safe}">${safe}</span>`;
                            }
                        },
                        {
                            targets: 6,
                            className: 'text-nowrap',
                            render: function (data, type) {
                                const approved = data === true;
                                const text = approved ? 'ONAYLANDI!' : ' ONAYLANMADI!';
                                if (type !== 'display') return text;
                                return `<span class="badge badge-pill badge-${approved ? 'success' : 'danger'}">
                                            <i class="la ${approved ? 'la-check-circle' : 'la-times-circle'}"></i> ${text}
                                        </span>`;
                            }
                        },
                        { targets: -1, orderable: false, searchable: false, className: 'text-nowrap', width: '1%' }
                    ]
                });

                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("https://localhost:7171/SignalRHub")
                    .build();

                let lastData = "";

                connection.start().then(() => {
                    setInterval(() => {
                        connection.invoke("GetBookingList");
                    }, 1000);
                }).catch((err) => console.log(err));

                connection.on("ReceiveBookingList", (values) => {
                    const json = JSON.stringify(values);
                    if (json === lastData) return;
                    lastData = json;

                    const rows = values.map((item, index) => [
                        index + 1,
                        escapeHtml(item.bookingName),
                        escapeHtml(item.bookingPhone),
                        item.bookingPersonCount,
                        escapeHtml(item.bookingMail),
                        item.bookingDescription, // render fonksiyonu kısaltıp escape ediyor
                        item.bookingStatus,      // render fonksiyonu rozete çeviriyor
                        `<a href="/Booking/BookingStatusApproved/${item.bookingID}" class="btn btn-sm btn-success" title="Onayla"><i class="la la-check"></i></a>
                         <a href="/Booking/BookingStatusCancelled/${item.bookingID}" class="btn btn-sm btn-dark" title="İptal Et"><i class="la la-ban"></i></a>
                         <a href="/Booking/BookingUpdate/${item.bookingID}" class="btn btn-sm btn-primary" title="Güncelle"><i class="la la-edit"></i></a>
                         <a href="/Booking/BookingDelete/${item.bookingID}" class="btn btn-sm btn-danger btn-delete" title="Sil"><i class="la la-trash"></i></a>`
                    ]);

                    table.clear().rows.add(rows).draw(false);
                });
            });
        </script>

        <h4 class="page-title">Rezervasyon</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="card-title mb-0">Rezervasyon Listesi</div>
                        <a href="/Booking/BookingCreate/" class="btn btn-success btn-round">
                            <i class="la la-plus"></i> Yeni Rezervasyon Ekle
                        </a>
                    </div>
                    <div class="card-body">

                        <div class="table-responsive">
                            <table id="bookingTable" class="table table-hover table-striped align-middle" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Ad Soyad</th>
                                        <th>Telefon</th>
                                        <th>Kişi Sayısı</th>
                                        <th>Mail</th>
                                        <th>Açıklama</th>
                                        <th>Rezervasyon Durumu</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'success',
            title: 'Başarılı!',
            text: '@TempData["SuccessMessage"]',
            timer: 2500,
            showConfirmButton: false
        });
    </script>
}

@if (TempData["DeleteMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Silindi!',
            text: '@TempData["DeleteMessage"]',
            timer: 2500,
            showConfirmButton: false
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'error',
            title: 'Hata!',
            text: '@TempData["ErrorMessage"]'
        });
    </script>
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap4.min.js"></script>
}