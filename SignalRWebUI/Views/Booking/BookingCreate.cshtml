@model CreateBookingDto

@{
    ViewData["Title"] = "BookingCreate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Rezervasyon</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Yeni Rezervasyon Ekleme</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="BookingName">Ad Soyad</label>
								<input asp-for="BookingName" type="text" class="form-control" id="BookingName" placeholder="Kategori Adı Giriniz...">
							</div>
							<div class="form-group">
								<label for="BookingPhone">Telefon</label>
								<input asp-for="BookingPhone" type="number" class="form-control" id="BookingPhone" placeholder="Telefon Giriniz...">
							</div>
							<div class="form-group">
								<label for="BookingMail">Mail Adresi</label>
								<input asp-for="BookingMail" type="email" class="form-control" id="BookingMail" placeholder="Mail Adresi Giriniz...">
							</div>
							<div class="form-group">
								<label for="BookingPersonCount">Kişi Sayısı</label>
								<input asp-for="BookingPersonCount" type="text" class="form-control" id="BookingPersonCount" placeholder="Kişi Sayısı Giriniz...">
							</div>
							<div class="form-group">
								<label for="BookingDate">Rezervasyon Tarihi</label>
								<input asp-for="BookingDate" type="date" class="form-control" id="BookingDate" placeholder="Tarih Seçiniz...">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success">Rezervasyon Oluştur</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>