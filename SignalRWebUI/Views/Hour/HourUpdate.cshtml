@model UpdateHourDto

@{
    ViewData["Title"] = "HourUpdate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Saatler</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Saat Güncelleme</div>
						</div>
						<input type="hidden" asp-for="HourID" />
						<div class="card-body">
							<div class="form-group">
								<label for="HourTitle">Başlık</label>
								<input asp-for="HourTitle" type="text" class="form-control" id="HourTitle" placeholder="Başlık Giriniz...">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="HourDay">Gün</label>
								<input asp-for="HourDay" type="text" class="form-control" id="HourDay" placeholder="Gün Giriniz...">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="HourDescription">Açıklama</label>
								<input asp-for="HourDescription" type="text" class="form-control" id="HourDescription" placeholder="Açıklama Giriniz...">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success">Saat Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>