@model List<ResultHourDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Saatler</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Saatler Listesi</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							Saatler ile ilgili işlemleri buradan gerçekleştirebilirsiniz.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Başlık</th>
									<th scope="col">Günler</th>
									<th scope="col">Açıklama</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.HourID</td>
										<td>@item.HourTitle</td>
										<td>@item.HourDay</td>
										<td>@item.HourDescription</td>
										<td><a href="/Hour/HourDelete/@item.HourID" class="btn btn-outline-danger">Sil</a></td>
										<td><a href="/Hour/HourUpdate/@item.HourID" class="btn btn-outline-primary">Güncelle</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/Hour/HourCreate/" class="btn btn-outline-success">Yeni Saat Ekle</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
