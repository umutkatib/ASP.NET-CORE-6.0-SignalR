@{
    Layout = null;
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>


<!DOCTYPE html>
<html>

@await Component.InvokeAsync("_UILayoutHeaderPartialComponent")

<body class="sub_page">

    @await Component.InvokeAsync("_MenuNavbarPartialComponent")

    <!-- food section -->

    <section class="food_section layout_padding">
        <div class="container">
            <div class="content">
                <div class="container-fluid">

                    <script type="text/javascript">
                        $(document).ready(() => {
                            var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7171/SignalRHub").build();

                            $("#connstatus").text(connection.state);

                            connection.start().then(() => {
                                $("#connstatus").text(connection.state);
                            }).catch((err) => {console.log(err)});

                            connection.on("ReceiveClientCount", (clientCount) => {
                            $("#clientcount").text(clientCount);
                            });

                        });
                    </script>

                    <h4 class="page-title">Anlık Client Sayısı: <strong id="clientcount"></strong></h4>

                </div>
            </div>
        </div>
    </section>

    <!-- end food section -->
    <!-- footer section -->
    @await Component.InvokeAsync("_UILayoutFooterPartialComponent")

    <!-- footer section -->
    @await Component.InvokeAsync("_UILayoutScriptPartialComponent")

</body>

</html>


