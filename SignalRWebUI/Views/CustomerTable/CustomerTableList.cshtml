@model List<ResultMenuTableDto>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
@await Component.InvokeAsync("_UILayoutHeaderPartialComponent")
<body class="sub_page">

    @await Component.InvokeAsync("_MenuNavbarPartialComponent")

    <!-- food section -->
    <br />
    <hr />
    <br />
    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-12">
                <nav class="breadcrumb bg-dark mb-30">
                    <a href="/Default/Index/" class="breadcrumb-item text-white">Ana Sayfa</a>
                    <a href="/Menu/Index/" class="breadcrumb-item text-white">Masa Listesi</a>
                    <span class="breadcrumb-item text-white active">Masa Seçimi Yapınız</span>
                </nav>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row px-xl-5">
            @foreach (var item in Model)
            {
                var isFull = item.MenuTableStatus == true;
                var cardColor = isFull ? "bg-danger" : "bg-success";
                var statusText = isFull ? "Dolu" : "Boş";

                <div class="col-md-3 mb-4">
                    @if (isFull)
                    {
                        <div class="h-100" style="cursor:not-allowed;">
                            <div class="card text-white @cardColor h-100">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-5">
                                            <div class="icon-big text-center">
                                                <i class="fa fa-cutlery" style="font-size:48px;"></i>
                                            </div>
                                        </div>
                                        <div class="col-7 d-flex align-items-center">
                                            <div class="numbers">
                                                <p class="card-category mb-1">@item.MenuTableName</p>
                                                <h4 class="card-title mb-0">@statusText</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a href="/Menu/Index/@item.MenuTableID" class="text-decoration-none d-block h-100">
                            <div class="card text-white @cardColor h-100">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-5">
                                            <div class="icon-big text-center">
                                                <i class="fa fa-shopping-cart" style="font-size:48px;"></i>
                                            </div>
                                        </div>
                                        <div class="col-7 d-flex align-items-center">
                                            <div class="numbers">
                                                <p class="card-category mb-1">@item.MenuTableName</p>
                                                <h4 class="card-title mb-0">@statusText</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }

        </div>
    </div>

    <!-- end food section -->
    <!-- footer section -->
    @await Component.InvokeAsync("_UILayoutFooterPartialComponent")

    <!-- footer section -->
    @await Component.InvokeAsync("_UILayoutScriptPartialComponent")

</body>

</html>
