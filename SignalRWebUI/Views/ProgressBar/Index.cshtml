@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
<script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<div class="content">
    <div class="container-fluid">

        <script type="text/javascript">
            $(document).ready(() => {
                var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7171/SignalRHub").build();

                $("#connstatus").text(connection.state);

                connection.start().then(() => {
                    setInterval(() => {
                     connection.invoke("SendProgress");
                    }, 1000)
                }).catch((err) => {console.log(err)});

                connection.on("ReceiveMoneyCaseAmount", (value1) => {
                $("#moneycaseamount").text(value1 + " ₺");
                });

                connection.on("ReceiveTotalActiveOrderCount", (value2) => {
                $("#totalactiveordercount").text(value2);
                });

                connection.on("ReceiveMenuTableCount", (value3) => {
                $("#menutablecount").text(value3);
                });

                connection.on("ReceiveCategoryCount", (value10) => {
                $("#categoryCount").text(value10);
                });

                connection.on("ReceiveProductCount", (value11) => {
                $("#productCount").text(value11);
                });

                connection.on("ReceiveBookingCount", (value12) => {
                $("#bookingCount").text(value12);
                });

                connection.on("ReceiveMenuTableCount", (value4) => {
                    $("#totalMenuTableCountProgress").empty();
                    $("#totalMenuTableCountProgress").append(
                    `
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Toplam Masa Sayısı</span>
                        <span class="text-muted fw-bold">${value4}</span>
                    </div>
                    <div class="progress mb-2" style="height: 7px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: ${value4}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value4}%">
                        </div>
                    </div>
                    `
                    );
                });

                connection.on("ReceiveProductPriceAvg", (value5) => {
                    $("#productPriceAvg").empty();
                    $("#productPriceAvg").append(
                    `
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Ortalama Ürün Fiyatı</span>
                        <span class="text-muted fw-bold">${value5}</span>
                    </div>
                    <div class="progress mb-2" style="height: 7px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: ${value5}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value5}%">
                        </div>
                    </div>
                    `
                    );
                });

                connection.on("ReceiveProductAvgPriceByHamburger", (value6) => {
                    $("#productPriceAvgPriceByHamburger").empty();
                    $("#productPriceAvgPriceByHamburger").append(
                    `
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Ortalama Hamburger Fiyatı</span>
                        <span class="text-muted fw-bold">${value6}</span>
                    </div>
                    <div class="progress mb-2" style="height: 7px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: ${value6}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value6}%">
                        </div>
                    </div>
                    `
                    );
                });

                connection.on("ReceiveProductCountByCategoryNameDrink", (value7) => {
                    $("#productProductCountByCategoryNameDrink").empty();
                    $("#productProductCountByCategoryNameDrink").append(
                    `
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">İçecek Kategori Sayısı</span>
                        <span class="text-muted fw-bold">${value7}</span>
                    </div>
                    <div class="progress mb-2" style="height: 7px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: ${value7}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value7}%">
                        </div>
                    </div>
                    `
                    );
                });

                connection.on("ReceiveTotalOrderCount", (value8) => {
                    $("#productTotalOrderCount").empty();
                    $("#productTotalOrderCount").append(
                    `
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Sipariş Sayısı</span>
                        <span class="text-muted fw-bold">${value8}</span>
                    </div>
                    <div class="progress mb-2" style="height: 7px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: ${value8}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value8}%">
                        </div>
                    </div>
                    `
                    );
                });

                connection.on("ReceiveTodayTotalPrice", (value9) => {
                    $("#productTodayTotalPrice").empty();
                    $("#productTodayTotalPrice").append(
                    `
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Günlük Kazanç</span>
                        <span class="text-muted fw-bold">${value9}</span>
                    </div>
                    <div class="progress mb-2" style="height: 7px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: ${value9}%" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100" data-toggle="tooltip" data-placement="top" title="${value9}%">
                        </div>
                    </div>
                    `
                    );
                });
            });
        </script>
        

        <h4 class="page-title">Admin İstatistikleri & Durumları</h4>
        <div class="row">
            <div class="col-md-12">

                <div class="row row-card-no-pd">
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-body">
                                <p class="fw-bold mt-1">Kasadaki Toplam Tutar</p>
                                <h4><b id="moneycaseamount"></b></h4>
                                <a href="/Order/OrderCreate/" class="btn btn-primary btn-full text-left mt-3 mb-3"><i class="la la-plus"></i> Yeni Sipariş</a>
                            </div>
                            <div class="card-footer">
                                <ul class="nav">
                                    <li class="nav-item"><a class="btn btn-default btn-link" href="/Order/Index/"><i class="la la-history"></i> Siparişler</a></li>
                                    <li class="nav-item ml-auto"><a class="btn btn-default btn-link" href="/ProgressBar/Index/"><i class="la la-refresh"></i> Sayfayı Yenile</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card">
                            <div class="card-body">

                                <div class="progress-card" id="totalMenuTableCountProgress">
                                    
                                </div>

                                <div class="progress-card" id="productPriceAvg">
                                   
                                </div>

                                <div class="progress-card" id="productPriceAvgPriceByHamburger">
                             
                                </div>

                                <div class="progress-card" id="productProductCountByCategoryNameDrink">
                                    
                                </div>

                                <div class="progress-card" id="productTotalOrderCount">
                                    
                                </div>

                                <div class="progress-card" id="productTotalOrderCount">

                                </div> 

                                <div class="progress-card" id="productTodayTotalPrice">

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card card-stats">
                            <div class="card-body">
                                <p class="fw-bold mt-1">Statistic</p>
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center icon-warning">
                                            <i class="la la-pie-chart text-warning"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Aktif Siparişler</p>
                                            <h4 class="card-title" id="totalactiveordercount"></h4>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center">
                                            <i class="la la-heart-o text-primary"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Toplam Masa Sayısı</p>
                                            <h4 class="card-title" id="menutablecount"></h4>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center">
                                            <i class="la la-car text-primary"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Kategori Sayısı</p>
                                            <h4 class="card-title" id="categoryCount"></h4>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center">
                                            <i class="la la-car text-primary"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Ürün Sayısı</p>
                                            <h4 class="card-title" id="productCount"></h4>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-5">
                                        <div class="icon-big text-center">
                                            <i class="la la-car text-primary"></i>
                                        </div>
                                    </div>
                                    <div class="col-7 d-flex align-items-center">
                                        <div class="numbers">
                                            <p class="card-category">Rezervasyon Sayısı</p>
                                            <h4 class="card-title" id="bookingCount"></h4>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>