@model List<ResultTastyAPI>

@{
    ViewData["Title"] = "Index";
    Layout = null;
}


<!DOCTYPE html>
<html>

@await Component.InvokeAsync("_UILayoutHeaderPartialComponent")

<body class="sub_page">

    @await Component.InvokeAsync("_MenuNavbarPartialComponent")

    <!-- food section -->
    <br />
    <hr />
    <br />
    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-12">
                <nav class="breadcrumb bg-dark mb-30">
                    <a href="/Default/Index/" class="breadcrumb-item text-white">Ana Sayfa</a>
                    <a href="/FoodRapidApi/Index/" class="breadcrumb-item text-white">API Listesi</a>
                    <span class="breadcrumb-item text-white active">Tasty API</span>
                </nav>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row px-xl-5">
            <div class="col-lg-12 table-responsive mb-5">
                <table class="table table-light table-borderless table-hover text-center ">
                    <thead class="thead-dark">
                        <tr>
                            <th>#</th>
                            <th>Ürün Adı</th>
                            <th>Tahmini Süre(dk)</th>
                            <th>Ülke</th>
                            <th>Detaylar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td><img src="@item.thumbnail_url" style="width:50px;height:50px"/></td>
                                <td>@item.Name</td>
                                @{
                                    if(item.total_time_minutes == 0)
                                    {
                                        <td>15</td>
                                    }
                                    else
                                    {
                                        <td>@item.total_time_minutes</td>
                                    }
                                }
                                <td>@item.country</td>
                                <td><a href="@item.original_video_url" class="btn btn-warning" target="_blank">İzle</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- end food section -->
    <!-- footer section -->
    @await Component.InvokeAsync("_UILayoutFooterPartialComponent")

    <!-- footer section -->
    @await Component.InvokeAsync("_UILayoutScriptPartialComponent")

</body>

</html>