@model LoginDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<title>Katib Restorant Admin Giriş</title>
	<!-- Mobile Specific Metas -->
	<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
	<!-- Font-->
	<link rel="stylesheet" type="text/css" href="~/colorlib-regform-32/css/nunito-font.css">
	<!-- Main Style Css -->
	<link rel="stylesheet" href="~/colorlib-regform-32/css/style.css" />
</head>
<body class="form-v6">
	<div class="page-content">
		<div class="form-v6-content">
			<div class="form-left">
				<img src="~/colorlib-regform-32/images/login-bg.png" alt="form">
			</div>
			<form class="form-detail" method="post">
				<h2>Katib Restorant Giriş</h2>
				<div class="form-row">
					<input type="text" class="input-text" placeholder="Kullanıcı Adınız" asp-for="UserName" required>
				</div>
				<div class="form-row">
					<input type="password" class="input-text" placeholder="Şifreniz" asp-for="Password" required>
				</div>
				<div asp-validation-summary="ModelOnly" class="login-error"></div>
				<div class="form-row-last">
					<input type="submit" class="register" value="Giriş Yap">
				</div>

				<p class="login-link">
					Bir hesabın yok mu? Hemen Kayıt Ol.
					<a asp-controller="Register" asp-action="Index">Kayıt Ol</a>
				</p>
			</form>
		</div>
	</div>
</body>
</html>
