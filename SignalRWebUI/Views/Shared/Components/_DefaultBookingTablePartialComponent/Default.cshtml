@model List<ResultBookingDto>

@foreach(var item in Model)
{
    <section class="book_section layout_padding">
        <div class="container">
            <div class="heading_container">
                <h2>
                    Rezervasyon Yapın
                </h2>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form_container">
                        <form action="">
                            <div>
                                <input type="text" class="form-control" placeholder="Adınız" />
                            </div>
                            <div>
                                <input type="text" class="form-control" placeholder="Telefon Numaranız" />
                            </div>
                            <div>
                                <input type="email" class="form-control" placeholder="Mail Adresiniz" />
                            </div>
                            <div>
                                <select class="form-control nice-select wide">
                                    <option value="" disabled selected>
                                        Kişi Sayısı?
                                    </option>
                                    <option value="">
                                        2
                                    </option>
                                    <option value="">
                                        3
                                    </option>
                                    <option value="">
                                        4
                                    </option>
                                    <option value="">
                                        5
                                    </option>
                                </select>
                            </div>
                            <div>
                                <input type="date" class="form-control">
                            </div>
                            <div class="btn_box">
                                <button>
                                    Şimdi Rezervasyon Yap
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="map_container ">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d63259.96856250872!2d-121.98017290169348!3d37.36091246544541!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x808fcbc3fab3c59b%3A0xbcfa443f6df67e3e!2sSan%20Jose%20Uluslararas%C4%B1%20Havaalan%C4%B1!5e0!3m2!1str!2str!4v1791911611442!5m2!1str!2str" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>
}