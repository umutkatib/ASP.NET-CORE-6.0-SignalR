@model List<ResultAboutDto>

@foreach(var item in Model)
{
    <section class="about_section layout_padding">
        <div class="container" id="aboutlink">

            <div class="row">
                <div class="col-md-6 ">
                    <div class="img-box">
                        <img src="@item.AboutImageUrl" alt="@item.AboutTitle">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="heading_container">
                            <h2>
                                @item.AboutTitle
                            </h2>
                        </div>
                        <p>
                            @item.AboutDescription
                        </p>
                        <a href="#aboutlink">
                            Daha Fazla
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}