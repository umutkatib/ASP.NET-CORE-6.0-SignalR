@model List<ResultMenuTableDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Masalar</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="card-title mb-0">Masa Listesi</div>
                        <a href="/MenuTable/MenuTableCreate/" class="btn btn-success btn-round">
                            <i class="la la-plus"></i> Yeni Masa Ekle
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Masalar ile ilgili işlemleri buradan gerçekleştirebilirsiniz.
                        </div>
                        <table class="table mt-3" id="menuTableTable">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Masa Adı</th>
                                    <th scope="col">Durum</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                    <th scope="col">Aktif/Pasif</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model == null || !Model.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            Henüz masa eklenmemiş.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <th>@item.MenuTableName</th>
                                            <td class="text-left">
                                                <span class="badge badge-pill badge-@(item.MenuTableStatus ? "success" : "danger")">
                                                    <i class="la @(item.MenuTableStatus ? "la-check-circle" : "la-times-circle")"></i>
                                                    @(item.MenuTableStatus ? "Aktif" : "Pasif")
                                                </span>
                                            </td>
                                            <td><a href="/MenuTable/MenuTableDelete/@item.MenuTableID" class="btn btn-outline-danger">Sil</a></td>
                                            <td><a href="/MenuTable/MenuTableUpdate/@item.MenuTableID" class="btn btn-outline-primary">Güncelle</a></td>
                                            <td>
                                                <a href="/MenuTable/ChangeMenuTableStatusToTrue/@item.MenuTableID" class="btn btn-sm btn-primary" title="Aktif"><i class="la la-check"></i></a>
                                                <a href="/MenuTable/ChangeMenuTableStatusToFalse/@item.MenuTableID" class="btn btn-sm btn-warning" title="Pasif"><i class="la la-ban"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap4.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#menuTableTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                columnDefs: [
                    { orderable: false, targets: [3, 4, 5] }
                ],
                language: {
                    info: "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    infoEmpty: "Kayıt bulunamadı",
                    infoFiltered: "(toplam _MAX_ kayıt içinden filtrelendi)",
                    lengthMenu: "Sayfada _MENU_ kayıt göster",
                    search: "Ara:",
                    zeroRecords: "Eşleşen kayıt bulunamadı",
                    paginate: {
                        first: "İlk",
                        last: "Son",
                        next: "Sonraki",
                        previous: "Önceki"
                    }
                }
            });
        });
    </script>
}