@model UpdateMenuTableDto

@{
    ViewData["Title"] = "Masa Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="page-title mb-0">Masa</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-0">
                    <li class="breadcrumb-item"><a href="/MenuTable/Index/">Masalar</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Masa Güncelle</li>
                </ol>
            </nav>
        </div>

        <div class="row">
            <div class="col-md-12">
                <form method="post" asp-action="MenuTableUpdate" asp-controller="MenuTable" id="menuTableForm" novalidate>
                    <input type="hidden" asp-for="MenuTableID" />

                    <div class="card product-card">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="la la-edit text-success mr-1"></i> Masa Güncelleme
                            </div>
                        </div>

                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="form-group">
                                <label asp-for="MenuTableName" class="font-weight-bold">Masa Adı</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-tag"></i></span>
                                    </div>
                                    <input asp-for="MenuTableName" class="form-control" maxlength="100"
                                           placeholder="Masa Adı Giriniz" />
                                </div>
                                <span asp-validation-for="MenuTableName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="card-action d-flex justify-content-between">
                            <a href="/MenuTable/Index/" class="btn btn-outline-secondary btn-round">
                                <i class="la la-arrow-left"></i> Vazgeç
                            </a>
                            <button type="submit" class="btn btn-success btn-round" id="btnSubmit">
                                <i class="la la-check"></i> Masayı Güncelle
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .product-card {
            border: 0;
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
        }

            .product-card .form-control:focus {
                border-color: #31ce36;
                box-shadow: 0 0 0 .15rem rgba(49,206,54,.2);
            }

            .product-card .input-group-text {
                background: #f8f9fa;
            }
    </style>
    <script>
        // Çift tıklamayla formun iki kez gönderilmesini engeller
        $('#menuTableForm').on('submit', function () {
            if ($(this).valid()) {
                $('#btnSubmit').prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm"></span> Güncelleniyor...');
            }
        });
    </script>
}