@model UpdateMenuTableDto

@{
    ViewData["Title"] = "MenuTableUpdate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Masalar</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<input type="hidden" asp-for="MenuTableID" />
						<div class="card-header">
							<div class="card-title">Yeni Masa Güncelleme</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="MenuTableName">Masa Adı</label>
								<input asp-for="MenuTableName" type="text" class="form-control" id="MenuTableName" placeholder="Masa Adı Giriniz...">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success">Masayı Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
