@model CreateBookingDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html>

@await Component.InvokeAsync("_UILayoutHeaderPartialComponent")

<body class="sub_page">

    @await Component.InvokeAsync("_MenuNavbarPartialComponent")


    <section class="book_section layout_padding">
        <div class="container">
            <div class="heading_container">
                <h2>
                    Şimdi Rezervasyon Yapın
                </h2>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form_container">
                        <form method="post">
                            <div>
                                <input type="text" asp-for="BookingName" class="form-control" placeholder="Ad Soyad" />
                            </div>
                            <div>
                                <input type="text" asp-for="BookingPhone" class="form-control" placeholder="Telefon Numarası" />
                            </div>
                            <div>
                                <input type="email" asp-for="BookingMail" class="form-control" placeholder="Mail Adresi" />
                            </div>
                            <div>
                                <select asp-for="BookingPersonCount" class="form-control nice-select wide">
                                    <option value="" disabled selected>
                                        Kaç Kişi?
                                    </option>
                                    <option value="1">
                                        1
                                    </option>
                                    <option value="2">
                                        2
                                    </option>
                                    <option value="3">
                                        3
                                    </option>
                                    <option value="4">
                                        4
                                    </option>
                                    <option value="5">
                                        5+
                                    </option>
                                </select>
                            </div>
                            <div>
                                <input type="date" asp-for="BookingDate" class="form-control">
                            </div>
                            <div class="btn_box">
                                <button>
                                    Rezervasyon Oluştur
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="map_container ">
                        <div id="googleMap"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    @await Component.InvokeAsync("_UILayoutFooterPartialComponent")

    @await Component.InvokeAsync("_UILayoutScriptPartialComponent")

</body>

</html>
