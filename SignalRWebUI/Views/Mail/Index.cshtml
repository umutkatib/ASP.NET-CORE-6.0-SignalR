@model CreateMailDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <form method="post" asp-action="Index" asp-controller="Mail" id="mailForm" novalidate>
                    <div class="card mail-card">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="la la-folder-plus text-success mr-1"></i> Mail Gönderme
                            </div>
                        </div>

                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="form-group">
                                <label asp-for="ReceiverMail" class="font-weight-bold">Alıcı Mail</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-tag"></i></span>
                                    </div>
                                    <input type="text" asp-for="ReceiverMail" class="form-control" maxlength="100"
                                           placeholder="Alıcı Mailini Giriniz" />
                                    <span asp-validation-for="ReceiverMail" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Subject" class="font-weight-bold">Konu</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-tag"></i></span>
                                    </div>
                                    <input type="text" asp-for="Subject" class="form-control" maxlength="100"
                                           placeholder="Konuyu Giriniz" />
                                    <span asp-validation-for="Subject" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Content" class="font-weight-bold">Mesaj</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-tag"></i></span>
                                    </div>
                                    <textarea rows="5" type="text" asp-for="Content" class="form-control" maxlength="100"
                                              placeholder="Mesajınızı Giriniz">
                                    </textarea>
                                    <span asp-validation-for="Content" class="text-danger small"></span>
                                </div>
                            </div>

                        </div>



                        <div class="card-action d-flex justify-content-between">
                            <a href="/Category/Index/" class="btn btn-outline-secondary btn-round">
                                <i class="la la-arrow-left"></i> Vazgeç
                            </a>
                            <button type="submit" class="btn btn-success btn-round" id="btnSubmit">
                                <i class="la la-check"></i> Mail Gönder
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .mail-card {
            border: 0;
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
        }

            .mail-card .form-control:focus {
                border-color: #31ce36;
                box-shadow: 0 0 0 .15rem rgba(49,206,54,.2);
            }

            .mail-card .input-group-text {
                background: #f8f9fa;
            }
    </style>
    <script>
        // Çift tıklamayla aynı kaydın iki kez eklenmesini engeller
        $('#mailForm').on('submit', function () {
            if ($(this).valid()) {
                $('#btnSubmit').prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm"></span> Kaydediliyor...');
            }
        });
    </script>
}