@model CreateDiscountDto
@{
    ViewData["Title"] = "DiscountCreate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Günün İndirimleri</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
				<div class="card">
					<div class="card-header">
							<div class="card-title">Yeni Günün İndirimi Ekleme</div>
					</div>
					<div class="card-body">
						<div class="form-group">
							<label for="DiscountTitle">Ürün Adı</label>
							<input asp-for="DiscountTitle" type="text" class="form-control" id="DiscountTitle" placeholder="Ürün Adı Giriniz...">
						</div>
					</div>
					<div class="card-body">
						<div class="form-group">
							<label for="DiscountAmount">İndirim Oranı</label>
								<input asp-for="DiscountAmount" type="text" class="form-control" id="DiscountAmount" placeholder="İndirim Oranı Giriniz...">
						</div>
					</div>
					<div class="card-body">
						<div class="form-group">
							<label for="DiscountImageUrl">Ürün Görseli</label>
								<input asp-for="DiscountImageUrl" type="text" class="form-control" id="DiscountImageUrl" placeholder="Ürün Görseli Giriniz...">
						</div>
					</div>
					<div class="card-body">
						<div class="form-group">
							<label for="DiscountTitle">Ürün Açıklaması</label>
								<input asp-for="DiscountDescription" type="text" class="form-control" id="DiscountDescription" placeholder="Ürün Açıklaması Giriniz...">
						</div>
					</div>
					<div class="card-action">
							<button class="btn btn-success">Günün İndirimini Ekle</button>
					</div>
				</div>
				</form>
			</div>
		</div>
	</div>
</div>
