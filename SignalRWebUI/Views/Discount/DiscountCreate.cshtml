@model CreateDiscountDto

@{
    ViewData["Title"] = "Yeni Günün İndirimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="page-title mb-0">Günün İndirimleri</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-0">
                    <li class="breadcrumb-item"><a href="/Discount/Index/">Günün İndirimleri</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Yeni Günün İndirimi</li>
                </ol>
            </nav>
        </div>

        <div class="row">
            <div class="col-md-12">
                <form method="post" asp-action="DiscountCreate" asp-controller="Discount" id="discountForm" novalidate>
                    <div class="card product-card">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="la la-percent text-success mr-1"></i> Yeni Günün İndirimi Ekleme
                            </div>
                        </div>

                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="form-group">
                                <label asp-for="DiscountTitle" class="font-weight-bold">Ürün Adı</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-tag"></i></span>
                                    </div>
                                    <input asp-for="DiscountTitle" class="form-control" maxlength="150"
                                           placeholder="Ürün Adı Giriniz..." autofocus />
                                </div>
                                <span asp-validation-for="DiscountTitle" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="DiscountAmount" class="font-weight-bold">İndirim Oranı</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-percent"></i></span>
                                    </div>
                                    <input asp-for="DiscountAmount" class="form-control"
                                           placeholder="İndirim Oranı Giriniz..." />
                                </div>
                                <span asp-validation-for="DiscountAmount" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="DiscountImageUrl" class="font-weight-bold">Ürün Görseli</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-image"></i></span>
                                    </div>
                                    <input asp-for="DiscountImageUrl" class="form-control"
                                           placeholder="https://... veya /images/urun.jpg" />
                                </div>
                                <span asp-validation-for="DiscountImageUrl" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="DiscountDescription" class="font-weight-bold">Ürün Açıklaması</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="la la-align-left"></i></span>
                                    </div>
                                    <textarea asp-for="DiscountDescription" class="form-control" rows="3"
                                              placeholder="Ürün Açıklaması Giriniz..."></textarea>
                                </div>
                                <span asp-validation-for="DiscountDescription" class="text-danger small"></span>
                            </div>

                            <div class="form-group">
                                <label class="font-weight-bold d-block">Durum</label>
                                <div class="custom-control custom-switch">
                                    <input asp-for="DiscountStatus" type="checkbox" class="custom-control-input" />
                                    <label class="custom-control-label" asp-for="DiscountStatus">Aktif</label>
                                </div>
                            </div>
                        </div>

                        <div class="card-action d-flex justify-content-between">
                            <a href="/Discount/Index/" class="btn btn-outline-secondary btn-round">
                                <i class="la la-arrow-left"></i> Vazgeç
                            </a>
                            <button type="submit" class="btn btn-success btn-round" id="btnSubmit">
                                <i class="la la-check"></i> Günün İndirimini Ekle
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .product-card {
            border: 0;
            border-radius: 10px;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
        }

            .product-card .form-control:focus {
                border-color: #31ce36;
                box-shadow: 0 0 0 .15rem rgba(49,206,54,.2);
            }

            .product-card .input-group-text {
                background: #f8f9fa;
            }
    </style>
    <script>
        // Çift tıklamayla aynı kaydın iki kez eklenmesini engeller
        $('#discountForm').on('submit', function () {
            if ($(this).valid()) {
                $('#btnSubmit').prop('disabled', true)
                    .html('<span class="spinner-border spinner-border-sm"></span> Kaydediliyor...');
            }
        });
    </script>
}