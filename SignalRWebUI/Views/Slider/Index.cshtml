@model List<ResultSliderDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Öne Çıkanlar</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="card-title mb-0">Öne Çıkanlar Listesi</div>
                        <a href="/Slider/SliderCreate/" class="btn btn-success btn-round">
                            <i class="la la-plus"></i> Yeni Öne Çıkan Ekle
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Öne Çıkanlar ile ilgili işlemleri buradan gerçekleştirebilirsiniz.
                        </div>
                        <div class="table-responsive">
                            <table class="table mt-3">
                                <thead>
                                    <tr>
                                        <th scope="col">Başlık 1</th>
                                        <th scope="col">Başlık 2</th>
                                        <th scope="col">Başlık 3</th>
                                        <th scope="col">Açıklama 1</th>
                                        <th scope="col">Açıklama 2</th>
                                        <th scope="col">Açıklama 3</th>
                                        <th scope="col">Sil</th>
                                        <th scope="col">Güncelle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model == null || !Model.Any())
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-4">
                                                Henüz öne çıkan alan eklenmemiş.
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <th>@item.SliderTitle1</th>
                                                <td>@item.SliderTitle2</td>
                                                <td>@item.SliderTitle3</td>
                                                <td>@item.SliderDescription1</td>
                                                <td>@item.SliderDescription2</td>
                                                <td>@item.SliderDescription3</td>
                                                <td><a href="/Slider/SliderDelete/@item.SliderID" class="btn btn-outline-danger">Sil</a></td>
                                                <td><a href="/Slider/SliderUpdate/@item.SliderID" class="btn btn-outline-primary">Güncelle</a></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
