@model List<ResultProductDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Ürünler</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="card-title mb-0">Ürün Listesi</div>
                        <a href="/Product/ProductCreate/" class="btn btn-success btn-round">
                            <i class="la la-plus"></i> Yeni Ürün Ekle
                        </a>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Ürünler ile ilgili işlemleri buradan gerçekleştirebilirsiniz.
                        </div>
                        <table class="table mt-3" id="productTable">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Ürün Adı</th>
                                    <th scope="col">Fiyat</th>
                                    <th scope="col">Kategori</th>
                                    <th scope="col">Durum</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                    <th scope="col">Aktif/Pasif</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model == null || !Model.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">
                                            Henüz ürün eklenmemiş.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <th>@item.ProductName</th>
                                            <td>@item.ProductPrice</td>
                                            <td>@item.CategoryName</td>
                                            <td class="text-left">
                                                <span class="badge badge-pill badge-@(item.ProductStatus ? "success" : "danger")">
                                                    <i class="la @(item.ProductStatus ? "la-check-circle" : "la-times-circle")"></i>
                                                    @(item.ProductStatus ? "Aktif" : "Pasif")
                                                </span>
                                            </td>
                                            <td><a href="/Product/ProductDelete/@item.ProductID" class="btn btn-outline-danger">Sil</a></td>
                                            <td><a href="/Product/ProductUpdate/@item.ProductID" class="btn btn-outline-primary">Güncelle</a></td>
                                            <td>
                                                <a href="/Product/ChangeProductStatusToTrue/@item.ProductID" class="btn btn-sm btn-primary" title="Aktif"><i class="la la-check"></i></a>
                                                <a href="/Product/ChangeProductStatusToFalse/@item.ProductID" class="btn btn-sm btn-warning" title="Pasif"><i class="la la-ban"></i></a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap4.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#productTable').DataTable({
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                columnDefs: [
                    { orderable: false, targets: [3] }
                ],
                language: {
                    info: "_TOTAL_ kayıttan _START_ - _END_ arası gösteriliyor",
                    infoEmpty: "Kayıt bulunamadı",
                    infoFiltered: "(toplam _MAX_ kayıt içinden filtrelendi)",
                    lengthMenu: "Sayfada _MENU_ kayıt göster",
                    search: "Ara:",
                    zeroRecords: "Eşleşen kayıt bulunamadı",
                    paginate: {
                    first: "İlk",
                    last: "Son",
                    next: "Sonraki",
                    previous: "Önceki"
                    }
                }
            });
        });
    </script>
}
