@model CreateProductDto

@{
    ViewData["Title"] = "ProductCreate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Ürün</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<div class="card-header">
							<div class="card-title">Yeni Ürün Ekleme</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="ProductName">Ürün Adı</label>
								<input asp-for="ProductName" type="text" class="form-control" id="ProductName" placeholder="Ürün Adı Giriniz...">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="ProductPrice">Ürün Fiyatı</label>
								<input asp-for="ProductPrice" type="text" class="form-control" id="ProductPrice" placeholder="Ürün Fiyatı Giriniz...">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="ProductImageURl">Ürün Görseli</label>
								<input asp-for="ProductImageURl" type="text" class="form-control" id="ProductImageURl" placeholder="Ürün Görseli Giriniz...">
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="CategoryID">Ürün Kategorisi</label>
								@Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.v, new {@class="form-control"})
							</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="ProductDescription">Ürün Açıklaması</label>
								<input asp-for="ProductDescription" type="text" class="form-control" id="ProductDescription" placeholder="Ürün Açıklaması Giriniz...">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success">Ürünü Ekle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
