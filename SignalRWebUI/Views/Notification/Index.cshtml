@model List<ResultNotificationDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Bildirimler</h4>
		<div class="row">
			<div class="col-md-12">
				<div class="card">
					<div class="card-header">
						<div class="card-title">Bildirim Listesi</div>
					</div>
					<div class="card-body">
						<div class="card-sub">
							Bildirimler ile ilgili işlemleri buradan gerçekleştirebilirsiniz.
						</div>
						<table class="table mt-3">
							<thead>
								<tr>
									<th scope="col">#</th>
									<th scope="col">Açıklama</th>
									<th scope="col">Tarih</th>
									<th scope="col">Durum</th>
									<th scope="col">Sil</th>
									<th scope="col">Güncelle</th>
									<th scope="col">Okundu Olarak İşaretle</th>
									<th scope="col">Okunmadı Olarak İşaretle</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var item in Model)
								{
									<tr>
										<td>@item.NotificationID</td>
										<td>@item.NotificationDescription</td>
										<td>@item.NotificationDate</td>
										<td>@item.NotificationStatus</td>
										<td><a href="/Notification/NotificationDelete/@item.NotificationID" class="btn btn-outline-danger">Sil</a></td>
										<td><a href="/Notification/NotificationUpdate/@item.NotificationID" class="btn btn-outline-primary">Güncelle</a></td>
										<td><a href="/Notification/NotificationStatusChangeToTrue/@item.NotificationID" class="btn btn-outline-warning">Okundu</a></td>
										<td><a href="/Notification/NotificationStatusChangeToFalse/@item.NotificationID" class="btn btn-outline-secondary">Okunmadı</a></td>
									</tr>
								}
							</tbody>
						</table>
						<a href="/Notification/NotificationCreate/" class="btn btn-outline-success">Yeni Bildirim Ekle</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

