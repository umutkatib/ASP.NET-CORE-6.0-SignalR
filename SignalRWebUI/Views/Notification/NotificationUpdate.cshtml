@model UpdateNotificationDto

@{
    ViewData["Title"] = "NotificationUpdate";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="content">
	<div class="container-fluid">
		<h4 class="page-title">Bildirim</h4>
		<div class="row">
			<div class="col-md-12">
				<form method="post">
					<div class="card">
						<input type="hidden" asp-for="NotificationID" />
						<div class="card-header">
							<div class="card-title">Yeni Bildirim Güncelleme</div>
						</div>
						<div class="card-body">
							<div class="form-group">
								<label for="NotificationType">Tür</label>
								<input asp-for="NotificationType" type="text" class="form-control" id="NotificationType" placeholder="Bildirim Türü Giriniz...">
							</div>
							<div class="form-group">
								<label for="NotificationIcon">Ikon</label>
								<input asp-for="NotificationIcon" type="text" class="form-control" id="NotificationIcon" placeholder="Bildirim İkonu Giriniz...">
							</div>
							<div class="form-group">
								<label for="NotificationDescription">Açıklama</label>
								<input asp-for="NotificationDescription" type="text" class="form-control" id="NotificationDescription" placeholder="Bildirim Açıklaması Giriniz...">
							</div>
						</div>
						<div class="card-action">
							<button class="btn btn-success">Bildirimi Güncelle</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
